---
import Layout from '../../layouts/Layout.astro';
import PaperLinks from '../../components/PaperLinks.astro';
import ResearchFigure from '../../components/ResearchFigure.astro';
import { papers } from '../../data/research';
import { jmpDetail } from '../../data/jmp';
import { url } from '../../lib/urls';
const paper = papers.find(paper => paper.id === 'job-application-timing')!;
const separator = paper.title.indexOf(': ');
const title = paper.title.slice(0, separator);
const subtitle = paper.title.slice(separator + 2);
---
<Layout title={title} description={paper.summary}>
  <article class="paper-detail">
    <header class="page-heading paper-heading">
      <p class="eyebrow"><a href={url('/research/')}>Research</a> <span aria-hidden="true">/</span> Job market paper</p>
      <h1>{title}</h1>
      <p class="paper-subtitle">{subtitle}</p>
      <p class="paper-date">{jmpDetail.sourceLabel} · {jmpDetail.sourceDate}</p>
      <PaperLinks paper={paper} includeSummary={false} />
      <p class="lead paper-answer">{jmpDetail.lead}</p>
      <nav class="section-nav" aria-label="Paper summary sections">{jmpDetail.sections.map(section => <a href={`#${section.id}`}>{section.title} <span aria-hidden="true">↓</span></a>)}</nav>
    </header>
    {jmpDetail.sections.map(section => <section class="section-grid detail-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
      <div class="section-label"><h2 id={`${section.id}-heading`}>{section.title}</h2></div>
      <div class="detail-prose">
        {section.paragraphs.map(paragraph => <p>{Array.isArray(paragraph) ? paragraph.map(part => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>) : paragraph}</p>)}
        {section.figure && <ResearchFigure figure={section.figure} compact />}
        {section.figureGroup && <figure class="research-figure research-figure-group">
          <div class="research-figure-grid">{section.figureGroup.figures.map(figure => <ResearchFigure figure={figure} />)}</div>
          <figcaption>{section.figureGroup.caption}</figcaption>
        </figure>}
      </div>
    </section>)}
    <div class="detail-closing"><a class="text-link" href={url('/research/')}><span aria-hidden="true">←</span> All research</a><PaperLinks paper={paper} includeSummary={false} /></div>
  </article>
</Layout>
