{
  "name": "saizhang-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "sync:docs": "node scripts/sync-documents.mjs",
    "update:docs": "npm run sync:docs && npm run check && npm run build && npm run verify",
    "publish:docs": "node scripts/publish-documents.mjs",
    "test:publish-docs": "node --test scripts/publish-documents.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "preview:stop": "ASTRO_TELEMETRY_DISABLED=1 astro preview stop"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
